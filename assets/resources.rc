#include "app_version.h++"
#include <windows.h>

// Icon
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO	VERSIONINFO
FILEVERSION		VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
PRODUCTVERSION	VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,VERSION_BUILD
FILEOS			VOS_NT_WINDOWS32
FILETYPE		VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",		"catsflex"
			VALUE "FileDescription",	"Utility to disable/enable PUBG intro movies."
			VALUE "FileVersion",		VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
